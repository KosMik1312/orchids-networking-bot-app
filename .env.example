# ===== БАЗА ДАННЫХ =====
# Для локальной разработки (SQLite):
# DATABASE_URL=sqlite+aiosqlite:///./bot/allora.db

# Для production на VPS (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://allora_user:your_secure_password@localhost:5432/allora_db

# Альтернативный способ настройки (если не используешь DATABASE_URL):
# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=allora_user
# DB_PASSWORD=your_secure_password
# DB_NAME=allora_db

# Параметры подключения БД
DB_POOL_SIZE=5              # Основной пул соединений
DB_POOL_MAX_OVERFLOW=10     # Дополнительные соединения при пиках
DB_POOL_RECYCLE=3600        # Переиспользовать соединения каждый час (в секундах)
DB_ECHO=false               # Логирование SQL запросов (false в production!)

# ===== БОТ =====
# Примечание: ОБЯЗАТЕЛЬНО замените BOT_TOKEN на реальный токен от @BotFather
# Пример: BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
BOT_TOKEN=YOUR_BOT_TOKEN
MINIAPP_URL=
# Сгенерируйте SECRET_KEY (рекомендуется >=32 символов):
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-generated-secret-key

# ID администраторов (через запятую, без пробелов)
# Пример: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# ===== ПЛАТЕЖИ (Yookassa) =====
# Если используете Yookassa, укажите параметры
YOOKASSA_SHOP_ID=
YOOKASSA_API_KEY=

# ===== АДМИНИСТРАТОРЫ =====
# Разделены запятыми без пробелов
ADMIN_IDS=

# ===== ПЛАТЕЖИ (Yookassa) =====
# YOOKASSA_SHOP_ID=your_shop_id
# YOOKASSA_API_KEY=your_api_key

# ===== API АУТЕНТИФИКАЦИЯ =====
# Отключить JWT аутентификацию (true = для разработки, false = для продакшена)
AUTH_DISABLED=false
