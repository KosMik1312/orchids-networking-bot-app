# Example environment variables for Orchids Networking Bot App
# Copy to .env and fill values for local development

# Telegram bot token
BOT_TOKEN=

# Public URL where MiniApp is hosted (used in bot links)
MINIAPP_URL=

# SQLite filename (relative to project root or bot/)
DATABASE_NAME=allora.db

# Admin IDs (comma-separated Telegram user IDs), e.g. 123456789,987654321
ADMIN_IDS=
