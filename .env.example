# ============================================
# ANTRE CLUB BOT - PRODUCTION CONFIGURATION
# ============================================
# ВАЖНО: Скопируй этот файл в .env и заполни реальными значениями!
# cp .env.example .env

# ============================================
# ДОМЕН (ОБЯЗАТЕЛЬНО!)
# ============================================
DOMAIN=your-domain.com

# ============================================
# БАЗА ДАННЫХ
# ============================================
DB_PASSWORD=your_strong_db_password_here

# ============================================
# TELEGRAM BOT
# ============================================
# Получить: https://t.me/BotFather
# Команда: /newbot
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Username бота (без @)
BOT_USERNAME=your_bot_username

# ============================================
# ЮKASSA (ПЛАТЕЖИ)
# ============================================
# Получить: https://yookassa.ru/my/merchant/integration
YOOKASSA_SHOP_ID=123456
YOOKASSA_SECRET_KEY=live_your_secret_key_here
YOOKASSA_TEST_MODE=false

# ============================================
# JWT СЕКРЕТ
# ============================================
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your_random_jwt_secret_here_min_32_chars

# ============================================
# АДМИНИСТРАТОРЫ
# ============================================
# Telegram ID администраторов через запятую (без пробелов)
# Узнать свой ID: https://t.me/userinfobot
ADMIN_IDS=123456789,987654321

# ============================================
# DATABASE SETTINGS (не меняй)
# ============================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=antre_club_db
DB_USER=antre_user
DB_ECHO=false
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
